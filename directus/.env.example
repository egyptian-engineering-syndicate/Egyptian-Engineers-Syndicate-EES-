# انسخ الملف ده باسم .env واملأ القيم قبل ما تشغل docker compose
# cp .env.example .env

# قيم أمان لازم تتغير - اعمل جيل جديد لكل بيئة (مش هتتحط في git أصلاً)
# ممكن تولدهم بـ: openssl rand -hex 16   و   openssl rand -hex 32
KEY=
SECRET=

# بيانات قاعدة البيانات (Postgres) - أي قيم تحبها للتطوير المحلي
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=directus

# أول حساب أدمن هيتعمل تلقائي أول ما directus يشتغل
ADMIN_EMAIL=admin@ees.local
ADMIN_PASSWORD=change-me-please

# رابط directus نفسه وrابط الفرونت المسموح له يكلمه (CORS)
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:3000
